<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnBackBorrow"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="← Quay lại trang chính"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LẬP PHIẾU MƯỢN SÁCH"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1A237E"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn sách (Chỉ hiển thị sách Có sẵn):"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerBooks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtTenNguoiMuon"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Họ tên người mượn (*)"
            android:inputType="textPersonName"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtSdt"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Số điện thoại người mượn (*)"
            android:inputType="phone"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtNgayMuon"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Bấm để chọn ngày mượn (*)"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtNgayTra"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Bấm để chọn ngày dự kiến trả (*)"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnBorrow"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Xác nhận lập phiếu mượn"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DANH SÁCH PHIẾU MƯỢN &amp; TRẢ SÁCH"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1A237E"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEmptySlips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có phiếu mượn nào."
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSlips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />


    </LinearLayout>
</ScrollView>
