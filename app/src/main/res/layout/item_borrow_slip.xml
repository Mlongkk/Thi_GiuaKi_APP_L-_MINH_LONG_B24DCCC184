<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:layout_marginBottom="10dp"
    android:elevation="2dp"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvBorrowMaSach"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mã phiếu #1 - Mã sách: S003"
        android:textStyle="bold"
        android:textColor="#1A237E"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvBorrowNguoiMuon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Người mượn: Lê Hoàng Nam - SĐT: 0912345678"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvBorrowNgay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ngày mượn: 10/11/2026 | Dự kiến trả: 24/11/2026"
        android:layout_marginTop="2dp" />

    <TextView
        android:id="@+id/tvBorrowTrangThai"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trạng thái: Đang mượn"
        android:textStyle="bold"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/btnReturnBook"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Trả sách"
        android:layout_gravity="end"
        android:layout_marginTop="8dp" />


</LinearLayout>
